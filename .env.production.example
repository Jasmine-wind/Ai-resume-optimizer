# Production deployment example for docker-compose.prod.yml
# Copy to the production runtime file .env and replace every placeholder before deployment.
# The ops scripts and the production compose contract default to .env.

SPRING_PROFILES_ACTIVE=prod
POSTGRES_DB=ai_resume_optimizer
POSTGRES_USER=ai_resume
POSTGRES_PASSWORD=change-me-production-postgres-password

REDIS_PASSWORD=change-me-production-redis-password
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
APP_REDIS_CACHE_ENABLED=true
APP_REDIS_DEFAULT_TTL_SECONDS=86400
APP_REDIS_AI_DISPLAY_MODEL_TTL_SECONDS=86400
APP_REDIS_KEY_PREFIX=ai-resume-optimizer

MINIO_ROOT_USER=ai-resume-minio
MINIO_ROOT_PASSWORD=change-me-production-minio-password
MINIO_ACCESS_KEY=ai-resume-minio
MINIO_SECRET_KEY=change-me-production-minio-password
MINIO_BUCKET=ai-resume-files
MINIO_PUBLIC_ENDPOINT=

APP_STORAGE_TYPE=minio
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://example.com
DEPLOY_DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# Platform does not provide a Chat credential. Every user supplies an encrypted BYOK.
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=16000

# Required production BYOK encryption infrastructure; keep the key ring in a secret store.
# Each value must decode to exactly 32 bytes (AES-256), e.g. v1=<base64url-key>.
AI_CREDENTIALS_ENABLED=true
AI_CREDENTIALS_ACTIVE_KEY_ID=v1
AI_CREDENTIALS_KEY_RING=replace-with-base64url-32-byte-key

# Metadata-only Provider attempt retention; no Resume/JD/Prompt/Output is retained.
AI_USAGE_RETENTION_ENABLED=true
AI_USAGE_RETENTION_DAYS=90

EMBEDDING_API_KEY=change-me-production-embedding-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_INPUT_LENGTH=8000

LOG_LEVEL_ROOT=info
LOG_LEVEL_APP=info
LOG_FILE_PATH=/app/logs/backend.log
