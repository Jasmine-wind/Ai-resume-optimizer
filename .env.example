# =========================================================
# AI Resume Optimizer environment example
# Values here are local examples or placeholders only.
# Copy to .env and replace private values before running locally.
# Do not use these passwords or secrets in shared or production environments.
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173

# ---------------------------------------------------------
# PostgreSQL container / database bootstrap
# Used by docker-compose.yml.
# ---------------------------------------------------------
POSTGRES_DB=ai_resume_optimizer
POSTGRES_USER=dawn
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5433

# ---------------------------------------------------------
# Backend JDBC
# Used by Spring Boot application-*.yaml.
# ---------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/ai_resume_optimizer
DB_USERNAME=dawn
DB_PASSWORD=change-me-local-postgres-password
FLYWAY_ENABLED=true

# ---------------------------------------------------------
# Redis settings used by docker-compose.yml.
# Redis is used by the backend for non-critical cache data.
# The first production scenario is AI resume display model cache.
# ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
APP_REDIS_CACHE_ENABLED=true
APP_REDIS_DEFAULT_TTL_SECONDS=86400
APP_REDIS_AI_DISPLAY_MODEL_TTL_SECONDS=86400
APP_REDIS_KEY_PREFIX=ai-resume-optimizer

# ---------------------------------------------------------
# JWT
# Must be replaced with a long random value outside local demos.
# ---------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=120
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------
# BYOK credential encryption infrastructure
# Local development may leave this disabled. Production must enable it and
# provide a stable AES-256 key ring through a secret store.
# ---------------------------------------------------------
AI_CREDENTIALS_ENABLED=false
AI_CREDENTIALS_ACTIVE_KEY_ID=v1
AI_CREDENTIALS_KEY_RING=

# AI runtime policy (not a provider credential)
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=90
# Reasoning models count thinking tokens against max_tokens; evidence matching
# needs enough headroom or the response may end with empty content.
AI_MAX_TOKENS=16000

# Optional real-AI smoke test only. These values are not used as a default
# provider for logged-in users; pass them only to test-specific configuration.
REAL_AI_BASE_URL=
REAL_AI_API_KEY=
REAL_AI_MODEL=

# Bounded metadata-only Provider attempt ledger. Never configure this as a content archive.
AI_USAGE_RETENTION_ENABLED=true
AI_USAGE_RETENTION_DAYS=90

# ---------------------------------------------------------
# OpenAI-compatible embedding service
# Production must inject a real API key through environment variables.
# ---------------------------------------------------------
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_INPUT_LENGTH=8000

# ---------------------------------------------------------
# Single-process async task executor
# ---------------------------------------------------------
APP_ASYNC_CORE_POOL_SIZE=4
APP_ASYNC_MAX_POOL_SIZE=8
APP_ASYNC_QUEUE_CAPACITY=100
APP_ASYNC_THREAD_NAME_PREFIX=ai-resume-task-
APP_ASYNC_AWAIT_TERMINATION_SECONDS=30

# ---------------------------------------------------------
# File storage
# Supported runtime storage types: local, minio.
# Local remains the default for local demos; production should prefer minio.
# ---------------------------------------------------------
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_BASE_DIR=uploads

# Backward-compatible legacy local storage variable.
# Prefer APP_STORAGE_LOCAL_BASE_DIR for new config.
LOCAL_STORAGE_BASE_DIR=uploads

# ---------------------------------------------------------
# MinIO container settings for local development
# Set APP_STORAGE_TYPE=minio to store uploaded resume files in MinIO.
# Bucket should stay private; file reads still go through backend permission checks.
# ---------------------------------------------------------
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=local-minio-user
MINIO_SECRET_KEY=change-me-local-minio-password
MINIO_BUCKET=ai-resume-files
MINIO_PUBLIC_ENDPOINT=

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
LOG_LEVEL_ROOT=info
LOG_LEVEL_APP=info
LOG_FILE_PATH=logs/ai-resume-optimizer.log
